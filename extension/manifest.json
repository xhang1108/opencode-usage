{
  "manifest_version": 3,
  "name": "Opencode Token Usage",
  "version": "0.8.5",
  "description": "Syncs opencode.ai usage token data into local storage and visualizes it in an integrated dashboard.",
  "permissions": [
    "storage",
    "scripting",
    "unlimitedStorage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://opencode.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendors/commandcode/mapper.js",
        "shared/canonical.js"
      ],
      "matches": [
        "https://commandcode.ai/*",
        "https://*.commandcode.ai/*"
      ]
    },
    {
      "resources": [
        "vendors/deepseek-official/mapper.js",
        "shared/canonical.js"
      ],
      "matches": [
        "https://*.deepseek.com/*"
      ]
    },
    {
      "resources": [
        "vendors/opencode/crawl-worker.js"
      ],
      "matches": [
        "https://opencode.ai/*"
      ]
    },
    {
      "resources": [
        "vendors/openrouter/mapper.js",
        "vendors/openrouter/analytics-query.js",
        "shared/canonical.js"
      ],
      "matches": [
        "https://openrouter.ai/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Opencode Token Usage",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://opencode.ai/*"
      ],
      "js": [
        "vendors/opencode/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "optional_host_permissions": [
    "https://*.commandcode.ai/*",
    "https://*.deepseek.com/*",
    "https://commandcode.ai/*",
    "https://openrouter.ai/*"
  ]
}
