{
  "source": "opencode",
  "label": "opencode",
  "mode": "crawl",
  "defaultEnabled": true,
  "costSource": "vendor",
  "origins": ["https://opencode.ai/*"],
  "crawl": {
    "contentScript": "vendors/opencode/api.js",
    "runAt": "document_start",
    "webAccessible": ["vendors/opencode/mapper.js", "shared/canonical.js"],
    "home": "https://opencode.ai/console",
    "defaultDays": 0
  },
  "import": ["json"],
  "ratesPreset": "rates.preset.json",
  "storage": {
    "opfs": false,
    "lease": false
  }
}
